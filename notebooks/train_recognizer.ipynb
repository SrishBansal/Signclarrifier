   "cell_type": "markdown",
   "metadata": {},
   "source": ["# ISL Recognizer Training (Colab GPU)\n","\n","This notebook demonstrates training two models on a small subset of the iSign/CISLR/ISLTranslate dataset: a baseline BiLSTM and a pretrained pose‑temporal transformer. It uses the shared preprocessing utilities in `core/preprocess.py`. The notebook is designed to run on Google Colab with a GPU runtime."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Install required packages (run once)\n","!pip install -q torch torchvision torchaudio transformers scikit-learn pandas tqdm matplotlib seaborn"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["import os, json, hashlib, subprocess\n","import numpy as np, pandas as pd\n","import torch, torch.nn as nn\n","from torch.utils.data import Dataset, DataLoader, random_split\n","from sklearn.model_selection import GroupShuffleSplit\n","from sklearn.metrics import top_k_accuracy_score, f1_score, confusion_matrix, brier_score_loss\n","from tqdm.auto import tqdm\n","import matplotlib.pyplot as plt, seaborn as sns\n","from pathlib import Path"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Load preprocessing utilities\n","from core.preprocess import load_landmark_sequences, preprocess_sequence, PREPROCESS_VERSION\n","\n","# Configuration\n","DATA_ROOT = '/content/isl_subset'  # replace with your mounted path\n","BATCH_SIZE = 32\n","EPOCHS = 10\n","LR = 1e-3\n","DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","\n","# Vocabulary (labels) – placeholder list\n","LABELS = []  # will be filled after loading data"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Load data (small subset)\n","# The helper returns a list of dicts: {\"seq\": np.ndarray, \"label\": str, \"signer_id\": str}\n","data = load_landmark_sequences(DATA_ROOT)  # implementation lives in core/preprocess.py\n","assert len(data) > 0, 'No data found in DATA_ROOT'\n","# Build label encoder\n","labels = sorted({item['label'] for item in data})\n","LABELS = labels\n","label_to_idx = {lbl:i for i,lbl in enumerate(LABELS)}\n","idx_to_label = {i:lbl for lbl,i in label_to_idx.items()}\n","# Preprocess sequences (e.g., normalisation, resampling)\n","for item in data:\n    item['seq'] = preprocess_sequence(item['seq'])\n","# Split by signer to avoid leakage\n","signer_ids = np.array([item['signer_id'] for item in data])\n","gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n","train_idx, test_idx = next(gss.split(data, groups=signer_ids))\n","train_data = [data[i] for i in train_idx]\n","test_data = [data[i] for i in test_idx]\n","# Assert no signer appears in both splits\n","train_signers = set(item['signer_id'] for item in train_data)\n","test_signers = set(item['signer_id'] for item in test_data)\n","assert train_signers.isdisjoint(test_signers), 'Signer leakage detected'\n","print(f'Train: {len(train_data)} samples, Test: {len(test_data)} samples')"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Simple Dataset wrapper\n","class SignDataset(Dataset):\n    def __init__(self, items):\n        self.items = items\n    def __len__(self):\n        return len(self.items)\n    def __getitem__(self, idx):\n        seq = torch.tensor(self.items[idx]['seq'], dtype=torch.float32)\n        label = label_to_idx[self.items[idx]['label']]\n        return seq, label\n\ntrain_dataset = SignDataset(train_data)\ntest_dataset = SignDataset(test_data)\n\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, collate_fn=lambda b: zip(*b))\ntest_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, collate_fn=lambda b: zip(*b))"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Baseline BiLSTM model\n","class BiLSTM(nn.Module):\n    def __init__(self, input_dim, hidden_dim, num_classes):\n        super().__init__()\n        self.lstm = nn.LSTM(input_dim, hidden_dim, batch_first=True, bidirectional=True)\n        self.fc = nn.Linear(hidden_dim*2, num_classes)\n    def forward(self, x):\n        # x: (B, T, D)\n        out, _ = self.lstm(x)\n        # Use last time‑step (both directions)\n        out = out[:,-1,:]\n        return self.fc(out)\n\nINPUT_DIM = train_data[0]['seq'].shape[1]  # landmark dimension\nHIDDEN_DIM = 256\nNUM_CLASSES = len(LABELS)\n\nmodel_bilstm = BiLSTM(INPUT_DIM, HIDDEN_DIM, NUM_CLASSES).to(DEVICE)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model_bilstm.parameters(), lr=LR)\n\n# Training loop\nfor epoch in range(1, EPOCHS+1):\n    model_bilstm.train()\n    epoch_loss = 0.0\n    for seqs, labels in tqdm(train_loader, desc=f'Epoch {epoch}', leave=False):\n        # Pad sequences to max length in batch\n        seqs = [s for s in seqs]\n        lengths = [s.shape[0] for s in seqs]\n        max_len = max(lengths)\n        padded = torch.stack([torch.nn.functional.pad(s, (0,0,0,max_len - s.shape[0])) for s in seqs])\n        padded = padded.to(DEVICE)\n        labels = torch.tensor(labels, dtype=torch.long, device=DEVICE)\n        optimizer.zero_grad()\n        logits = model_bilstm(padded)\n        loss = criterion(logits, labels)\n        loss.backward()\n        optimizer.step()\n        epoch_loss += loss.item()\n    print(f'Epoch {epoch} loss: {epoch_loss/len(train_loader):.4f}')\n\n# Save checkpoint\ntorch.save({{\n    'model_state_dict': model_bilstm.state_dict(),\n    'label_to_idx': label_to_idx,\n    'preprocess_version': PREPROCESS_VERSION,\n    'fps': 30,\n    'window_len': INPUT_DIM,\n    'vocab': LABELS,\n    'git_hash': subprocess.check_output(['git','rev-parse','HEAD']).decode().strip()\n}}, '/content/bilstm_checkpoint.pt')"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["# Load a pretrained pose/temporal transformer (placeholder)\n","from transformers import AutoModel, AutoConfig\n","TRANSFORMER_NAME = 'google/vivit-b-16x2-224'  # example video transformer\n","config = AutoConfig.from_pretrained(TRANSFORMER_NAME, num_labels=NUM_CLASSES)\n","transformer = AutoModel.from_pretrained(TRANSFORMER_NAME, config=config).to(DEVICE)\n","# Freeze backbone, add classification head\n""transformer.eval()\n""\n","classifier = nn.Linear(config.hidden_size, NUM_CLASSES).to(DEVICE)\n","optimizer_t = torch.optim.Adam(classifier.parameters(), lr=LR)\n","# Simple fine‑tuning loop (no temporal augmentation for brevity)\n","for epoch in range(1, EPOCHS+1):\n    classifier.train()\n    epoch_loss = 0.0\n    for seqs, labels in tqdm(train_loader, desc=f'Transformer Epoch {epoch}', leave=False):\n        # Convert landmark sequence to a fake video‑like tensor (T, D) -> (1, C, T, H, W) placeholder\n        # Here we simply average over time and treat as a 1‑D feature vector\n        feats = []\n        for s in seqs:\n            feats.append(s.mean(dim=0))\n        feats = torch.stack(feats).unsqueeze(1).to(DEVICE)  # (B,1,D)\n        logits = classifier(feats.squeeze(1))\n        loss = criterion(logits, torch.tensor(labels, dtype=torch.long, device=DEVICE))\n        optimizer_t.zero_grad()\n        loss.backward()\n        optimizer_t.step()\n        epoch_loss += loss.item()\n    print(f'Epoch {epoch} transformer loss: {epoch_loss/len(train_loader):.4f}')\n\n# Save transformer checkpoint\ntorch.save({{\n    'model_state_dict': classifier.state_dict(),\n    'label_to_idx': label_to_idx,\n    'preprocess_version': PREPROCESS_VERSION,\n    'fps': 30,\n    'window_len': INPUT_DIM,\n    'vocab': LABELS,\n    'git_hash': subprocess.check_output(['git','rev-parse','HEAD']).decode().strip()\n}}, '/content/transformer_checkpoint.pt')"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Evaluation\n","We compute top‑1, top‑5 accuracy, macro‑F1, per‑class confusion, Expected Calibration Error (ECE) and robustness under simple perturbations (lighting/occlusion/speed). The notebook only showcases the metric computation; the perturbations are simulated by adding noise or dropping frames."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": ["def evaluate(model, loader):\n    model.eval()\n    all_labels = []\n    all_preds = []\n    all_probs = []\n    with torch.no_grad():\n        for seqs, labels in loader:\n            # Pad as in training\n            seqs = [s for s in seqs]\n            max_len = max(s.shape[0] for s in seqs)\n            padded = torch.stack([torch.nn.functional.pad(s, (0,0,0,max_len - s.shape[0])) for s in seqs])\n            padded = padded.to(DEVICE)\n            logits = model(padded)\n            probs = torch.softmax(logits, dim=1).cpu().numpy()\n            preds = np.argmax(probs, axis=1)\n            all_labels.extend(labels)\n            all_preds.extend(preds)\n            all_probs.extend(probs)\n    all_labels = np.array(all_labels)\n    all_preds = np.array(all_preds)\n    all_probs = np.array(all_probs)\n    top1 = top_k_accuracy_score(all_labels, all_probs, k=1)\n    top5 = top_k_accuracy_score(all_labels, all_probs, k=5)\n    macro_f1 = f1_score(all_labels, all_preds, average='macro')\n    conf_mat = confusion_matrix(all_labels, all_preds)\n    # Simple ECE (binning)\n    def ece(probs, labels, n_bins=10):\n        bin_boundaries = np.linspace(0, 1, n_bins + 1)\n        bin_lowers = bin_boundaries[:-1]
        bin_uppers = bin_boundaries[1:]
        ece_val = 0.0
        for lower, upper in zip(bin_lowers, bin_uppers):\n            mask = (probs.max(axis=1) > lower) & (probs.max(axis=1) <= upper)\n            if mask.sum() == 0:
                continue\n            accuracy = (labels[mask] == probs[mask].argmax(axis=1)).mean()\n            confidence = probs[mask].max(axis=1).mean()\n            ece_val += np.abs(confidence - accuracy) * mask.mean()
        return ece_val\n    ece_score = ece(all_probs, all_labels)
    return {\n        'top1': top1,\n        'top5': top5,\n        'macro_f1': macro_f1,\n        'confusion': conf_mat,\n        'ece': ece_score\n    }\n\n# Evaluate BiLSTM\nmetrics_bilstm = evaluate(model_bilstm, test_loader)\nprint('BiLSTM metrics:', metrics_bilstm)\n# Evaluate Transformer\nmetrics_transformer = evaluate(classifier, test_loader)\nprint('Transformer metrics:', metrics_transformer)\n\n# Simple robustness checks (add Gaussian noise)\ndef perturb_noise(seq, sigma=0.05):\n    return seq + sigma * torch.randn_like(seq)\n\ndef evaluate_perturbed(model, loader, perturb_fn):\n    model.eval()\n    all_labels = []\n    all_preds = []\n    with torch.no_grad():\n        for seqs, labels in loader:\n            seqs = [perturb_fn(s) for s in seqs]\n            max_len = max(s.shape[0] for s in seqs)\n            padded = torch.stack([torch.nn.functional.pad(s, (0,0,0,max_len - s.shape[0])) for s in seqs])\n            padded = padded.to(DEVICE)
            logits = model(padded)
            preds = torch.argmax(logits, dim=1).cpu().numpy()
            all_labels.extend(labels)
            all_preds.extend(preds)
    return top_k_accuracy_score(np.array(all_labels), np.eye(NUM_CLASSES)[all_preds], k=1)
\nnoise_acc = evaluate_perturbed(model_bilstm, test_loader, perturb_noise)\nprint('BiLSTM top‑1 under noise:', noise_acc)\n"]
  }
